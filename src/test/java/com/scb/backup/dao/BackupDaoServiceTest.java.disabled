package com.scb.backup.dao;

import com.scb.backup.exception.DbBackupException;
import com.scb.backup.utils.AppConstants;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.jdbc.core.namedparam.NamedParameterJdbcTemplate;
import org.springframework.test.util.ReflectionTestUtils;

import java.sql.Timestamp;
import java.time.LocalDateTime;
import java.util.Date;
import java.util.HashMap;
import java.util.Map;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.*;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
@DisplayName("BackupDaoService Comprehensive Tests")
class BackupDaoServiceTest {

    @Mock
    private NamedParameterJdbcTemplate jdbcTemplate;

    @InjectMocks
    private BackupDaoService backupDaoService;

    private Map<String, Object> batchParams;

    @BeforeEach
    void setUp() {
        // Set up SQL queries using reflection
        ReflectionTestUtils.setField(backupDaoService, "insertFullBackup",
                "INSERT INTO full_backup_tracker VALUES (:batch_id, :category, :backup_month, :task_uuid, :response, :db_name)");
        ReflectionTestUtils.setField(backupDaoService, "updateFullBackupWithBaseUuidQuery",
                "UPDATE full_backup_tracker SET base_backup_uuid = :base_uuid WHERE category = :category AND backup_month = :backup_month");
        ReflectionTestUtils.setField(backupDaoService, "getBaseBackupUuidFromFullTracker",
                "SELECT base_backup_uuid FROM full_backup_tracker WHERE backup_month = :backup_month AND db_name = :db_name");
        ReflectionTestUtils.setField(backupDaoService, "insertIncrementalBackup",
                "INSERT INTO incremental_backup_tracker VALUES (:batch_id, :category, :backup_month, :task_uuid, :response, :base_uuid, :db_name)");
        ReflectionTestUtils.setField(backupDaoService, "updateIncrementalBackupStatus",
                "UPDATE incremental_backup_tracker SET status = :status WHERE batch_id = :batch_id");

        batchParams = new HashMap<>();
        batchParams.put(AppConstants.BATCH_ID, "BATCH_001");
        batchParams.put(AppConstants.CATEGORY_CODE, "HWA_EPR_DB_BACKUP_FULL");
        batchParams.put(AppConstants.BUSINESS_DATE, new Date());
    }

    @Test
    @DisplayName("Should successfully insert full backup record")
    void should_InsertFullBackupRecord_When_ValidParametersProvided() {
        // Given
        String backupMonth = "2026-02";
        String taskUuid = "task-uuid-123";
        String response = "{\"taskUUID\":\"task-uuid-123\"}";
        String dbName = "test_db";

        when(jdbcTemplate.update(anyString(), anyMap())).thenReturn(1);

        // When
        assertDoesNotThrow(() ->
                backupDaoService.insertFullBackupRecord(batchParams, backupMonth, taskUuid, response, dbName)
        );

        // Then
        verify(jdbcTemplate, times(1)).update(anyString(), anyMap());
    }

    @Test
    @DisplayName("Should throw DbBackupException when insert full backup fails")
    void should_ThrowDbBackupException_When_InsertFullBackupFails() {
        // Given
        String backupMonth = "2026-02";
        String taskUuid = "task-uuid-123";
        String response = "{\"taskUUID\":\"task-uuid-123\"}";
        String dbName = "test_db";

        when(jdbcTemplate.update(anyString(), anyMap()))
                .thenThrow(new RuntimeException("Database connection failed"));

        // When & Then
        DbBackupException exception = assertThrows(DbBackupException.class, () ->
                backupDaoService.insertFullBackupRecord(batchParams, backupMonth, taskUuid, response, dbName)
        );

        assertTrue(exception.getMessage().contains("Error inserting full backup record"));
        verify(jdbcTemplate, times(1)).update(anyString(), anyMap());
    }

    @Test
    @DisplayName("Should successfully update full backup with base UUID")
    void should_UpdateFullBackupWithBaseUuid_When_ValidParametersProvided() {
        // Given
        String categoryCode = "HWA_EPR_DB_BACKUP_FULL";
        String backupMonth = "2026-02";
        String baseBackupUuid = "base-uuid-123";
        String batchId = "BATCH_001";
        String backupStatus = AppConstants.BACKUP_SUCCESS_STATUS;

        when(jdbcTemplate.update(anyString(), anyMap())).thenReturn(1);

        // When
        assertDoesNotThrow(() ->
                backupDaoService.updateFullBackupWithBaseUuid(categoryCode, backupMonth, baseBackupUuid, batchId, backupStatus)
        );

        // Then
        verify(jdbcTemplate, times(1)).update(anyString(), anyMap());
    }

    @Test
    @DisplayName("Should throw DbBackupException when update full backup fails")
    void should_ThrowDbBackupException_When_UpdateFullBackupFails() {
        // Given
        String categoryCode = "HWA_EPR_DB_BACKUP_FULL";
        String backupMonth = "2026-02";
        String baseBackupUuid = "base-uuid-123";
        String batchId = "BATCH_001";
        String backupStatus = AppConstants.BACKUP_SUCCESS_STATUS;

        when(jdbcTemplate.update(anyString(), anyMap()))
                .thenThrow(new RuntimeException("Database update failed"));

        // When & Then
        DbBackupException exception = assertThrows(DbBackupException.class, () ->
                backupDaoService.updateFullBackupWithBaseUuid(categoryCode, backupMonth, baseBackupUuid, batchId, backupStatus)
        );

        assertTrue(exception.getMessage().contains("Error updating full backup with base UUID"));
        verify(jdbcTemplate, times(1)).update(anyString(), anyMap());
    }

    @Test
    @DisplayName("Should successfully get base backup UUID from database")
    void should_GetBaseBackupUuid_When_RecordExists() {
        // Given
        String backupMonth = "2026-02";
        String dbName = "test_db";
        String expectedUuid = "base-uuid-123";

        when(jdbcTemplate.queryForObject(anyString(), anyMap(), eq(String.class)))
                .thenReturn(expectedUuid);

        // When
        String actualUuid = backupDaoService.getBaseBackupUuidFromDb(backupMonth, dbName);

        // Then
        assertEquals(expectedUuid, actualUuid);
        verify(jdbcTemplate, times(1)).queryForObject(anyString(), anyMap(), eq(String.class));
    }

    @Test
    @DisplayName("Should return null when base backup UUID not found")
    void should_ReturnNull_When_BaseBackupUuidNotFound() {
        // Given
        String backupMonth = "2026-02";
        String dbName = "test_db";

        when(jdbcTemplate.queryForObject(anyString(), anyMap(), eq(String.class)))
                .thenThrow(new org.springframework.dao.EmptyResultDataAccessException(1));

        // When
        String actualUuid = backupDaoService.getBaseBackupUuidFromDb(backupMonth, dbName);

        // Then
        assertNull(actualUuid);
        verify(jdbcTemplate, times(1)).queryForObject(anyString(), anyMap(), eq(String.class));
    }

    @Test
    @DisplayName("Should successfully insert incremental backup record")
    void should_InsertIncrementalBackupRecord_When_ValidParametersProvided() {
        // Given
        String backupMonth = "2026-02";
        String taskUuid = "task-uuid-456";
        String response = "{\"taskUUID\":\"task-uuid-456\"}";
        String baseUuid = "base-uuid-123";
        String dbName = "test_db";

        when(jdbcTemplate.update(anyString(), anyMap())).thenReturn(1);

        // When
        assertDoesNotThrow(() ->
                backupDaoService.insertIncrementalBackupRecord(batchParams, backupMonth, taskUuid, response, baseUuid, dbName)
        );

        // Then
        verify(jdbcTemplate, times(1)).update(anyString(), anyMap());
    }

    @Test
    @DisplayName("Should successfully update incremental backup status")
    void should_UpdateIncrementalBackupStatus_When_ValidParametersProvided() {
        // Given
        String categoryCode = "HWA_EPR_DB_BACKUP_INCRE";
        String backupMonth = "2026-02";
        String batchId = "BATCH_001";
        String backupStatus = AppConstants.BACKUP_SUCCESS_STATUS;

        when(jdbcTemplate.update(anyString(), anyMap())).thenReturn(1);

        // When
        assertDoesNotThrow(() ->
                backupDaoService.updateIncrementalBackupStatus(categoryCode, backupMonth, batchId, backupStatus)
        );

        // Then
        verify(jdbcTemplate, times(1)).update(anyString(), anyMap());
    }
}

