package com.scb.backup.client;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.scb.backup.dao.BackupDaoService;
import com.scb.backup.model.YbaDynamicConfig;
import com.scb.backup.service.BackupPollerService;
import com.scb.backup.service.YbaConfigService;
import com.scb.backup.utils.AppConstants;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.web.reactive.function.client.WebClient;
import reactor.core.publisher.Mono;
import reactor.test.StepVerifier;

import java.util.Date;
import java.util.HashMap;
import java.util.Map;

import static org.mockito.ArgumentMatchers.*;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
@DisplayName("YbaClient Comprehensive Tests")
class YbaClientTest {

    @Mock
    private WebClient webClient;

    @Mock
    private BackupDaoService backupDaoService;

    @Mock
    private BackupPollerService backupPollerService;

    @Mock
    private YbaConfigService configService;

    @Mock
    private WebClient.RequestBodyUriSpec requestBodyUriSpec;

    @Mock
    private WebClient.RequestHeadersSpec requestHeadersSpec;

    @Mock
    private WebClient.RequestBodySpec requestBodySpec;

    @Mock
    private WebClient.ResponseSpec responseSpec;

    @InjectMocks
    private YbaClient ybaClient;

    private YbaDynamicConfig fullBackupConfig;
    private YbaDynamicConfig incrementalBackupConfig;
    private Map<String, Object> batchParams;
    private ObjectMapper mapper;

    @BeforeEach
    void setUp() {
        mapper = new ObjectMapper();

        fullBackupConfig = YbaDynamicConfig.builder()
                .fullBackupUrl("http://yba-api/full-backup")
                .incrementalBackupUrl("http://yba-api/incremental-backup")
                .lastBackupUrl("http://yba-api/last-backup")
                .jobCompletionCheckUrl("http://yba-api/task-status")
                .storageConfigUuid("storage-uuid-123")
                .apiToken("test-api-token")
                .universeUuid("universe-uuid-456")
                .backupType("YQL_TABLE_TYPE")
                .backupCategoryType(AppConstants.FULL_BACKUP)
                .dbName("test_db")
                .expiryMs(86400000L)
                .build();

        incrementalBackupConfig = YbaDynamicConfig.builder()
                .fullBackupUrl("http://yba-api/full-backup")
                .incrementalBackupUrl("http://yba-api/incremental-backup")
                .lastBackupUrl("http://yba-api/last-backup")
                .jobCompletionCheckUrl("http://yba-api/task-status")
                .storageConfigUuid("storage-uuid-123")
                .apiToken("test-api-token")
                .universeUuid("universe-uuid-456")
                .backupType("YQL_TABLE_TYPE")
                .backupCategoryType(AppConstants.INCREMENTAL_BACKUP)
                .dbName("test_db")
                .expiryMs(86400000L)
                .build();

        batchParams = new HashMap<>();
        batchParams.put(AppConstants.BATCH_ID, "BATCH_001");
        batchParams.put(AppConstants.CATEGORY_CODE, "HWA_EPR_DB_BACKUP_FULL");
        batchParams.put(AppConstants.BUSINESS_DATE, new Date());
    }

    @Test
    @DisplayName("Should successfully initiate full backup")
    void should_InitiateFullBackup_When_ValidConfigProvided() throws Exception {
        // Given
        String categoryCode = "HWA_EPR_DB_BACKUP_FULL";
        String taskUuid = "task-uuid-123";
        String baseUuid = "base-uuid-456";

        JsonNode mockResponse = mapper.readTree("{\"taskUUID\":\"" + taskUuid + "\"}");

        when(configService.resolve(categoryCode)).thenReturn(fullBackupConfig);
        doNothing().when(backupDaoService).insertBackupDetails(any(), anyString(), anyString());
        doNothing().when(backupDaoService).insertFullBackupRecord(any(), anyString(), anyString(), anyString(), anyString());

        when(webClient.post()).thenReturn(requestBodyUriSpec);
        when(requestBodyUriSpec.uri(anyString())).thenReturn(requestBodySpec);
        when(requestBodySpec.header(anyString(), anyString())).thenReturn(requestBodySpec);
        when(requestBodySpec.contentType(any())).thenReturn(requestBodySpec);
        when(requestBodySpec.bodyValue(any())).thenReturn(requestHeadersSpec);
        when(requestHeadersSpec.retrieve()).thenReturn(responseSpec);
        when(responseSpec.bodyToMono(JsonNode.class)).thenReturn(Mono.just(mockResponse));

        when(backupPollerService.pollFullBackupCompletion(any(), anyString(), anyString(), anyString(), anyString()))
                .thenReturn(Mono.just(baseUuid));

        // When
        Mono<String> result = ybaClient.backupInitiate(categoryCode, batchParams);

        // Then
        StepVerifier.create(result)
                .expectNextMatches(response -> response.contains(taskUuid))
                .verifyComplete();

        verify(configService).resolve(categoryCode);
        verify(backupDaoService).insertBackupDetails(any(), eq(AppConstants.BACKUP_INPROGRESS_STATUS), eq(AppConstants.FULL_BACKUP));
        verify(backupDaoService).insertFullBackupRecord(any(), anyString(), eq(taskUuid), anyString(), eq("test_db"));
        verify(backupPollerService).pollFullBackupCompletion(any(), eq(categoryCode), anyString(), eq(taskUuid), eq("BATCH_001"));
    }

    @Test
    @DisplayName("Should successfully initiate incremental backup with base UUID")
    void should_InitiateIncrementalBackup_When_BaseUuidExists() throws Exception {
        // Given
        String categoryCode = "HWA_EPR_DB_BACKUP_INCRE";
        String baseUuid = "base-uuid-123";
        String taskUuid = "task-uuid-456";

        JsonNode mockResponse = mapper.readTree("{\"taskUUID\":\"" + taskUuid + "\"}");

        when(configService.resolve(categoryCode)).thenReturn(incrementalBackupConfig);
        doNothing().when(backupDaoService).insertBackupDetails(any(), anyString(), anyString());
        when(backupDaoService.getBaseBackupUuidFromDb(anyString(), anyString())).thenReturn(baseUuid);
        doNothing().when(backupDaoService).insertIncrementalBackupRecord(any(), anyString(), anyString(), anyString(), anyString(), anyString());

        when(webClient.post()).thenReturn(requestBodyUriSpec);
        when(requestBodyUriSpec.uri(anyString())).thenReturn(requestBodySpec);
        when(requestBodySpec.header(anyString(), anyString())).thenReturn(requestBodySpec);
        when(requestBodySpec.contentType(any())).thenReturn(requestBodySpec);
        when(requestBodySpec.bodyValue(any())).thenReturn(requestHeadersSpec);
        when(requestHeadersSpec.retrieve()).thenReturn(responseSpec);
        when(responseSpec.bodyToMono(JsonNode.class)).thenReturn(Mono.just(mockResponse));

        when(backupPollerService.pollIncrementalBackupCompletion(any(), anyString(), anyString(), anyString(), anyString(), anyString()))
                .thenReturn(Mono.empty());

        // When
        Mono<String> result = ybaClient.backupInitiate(categoryCode, batchParams);

        // Then
        StepVerifier.create(result)
                .expectNextMatches(response -> response.contains(taskUuid))
                .verifyComplete();

        verify(backupDaoService).getBaseBackupUuidFromDb(anyString(), eq("test_db"));
        verify(backupDaoService).insertIncrementalBackupRecord(any(), anyString(), eq(taskUuid), anyString(), eq(baseUuid), eq("test_db"));
    }

    @Test
    @DisplayName("Should fail incremental backup when base UUID not found")
    void should_FailIncrementalBackup_When_BaseUuidNotFound() {
        // Given
        String categoryCode = "HWA_EPR_DB_BACKUP_INCRE";

        when(configService.resolve(categoryCode)).thenReturn(incrementalBackupConfig);
        doNothing().when(backupDaoService).insertBackupDetails(any(), anyString(), anyString());
        when(backupDaoService.getBaseBackupUuidFromDb(anyString(), anyString())).thenReturn(null);

        // When
        Mono<String> result = ybaClient.backupInitiate(categoryCode, batchParams);

        // Then
        StepVerifier.create(result)
                .expectErrorMatches(throwable ->
                        throwable instanceof IllegalStateException &&
                                throwable.getMessage().contains("No base backup UUID found"))
                .verify();

        verify(backupDaoService).getBaseBackupUuidFromDb(anyString(), eq("test_db"));
        verify(backupDaoService, never()).insertIncrementalBackupRecord(any(), anyString(), anyString(), anyString(), anyString(), anyString());
    }

    @Test
    @DisplayName("Should throw error when configuration not found")
    void should_ThrowError_When_ConfigurationNotFound() {
        // Given
        String categoryCode = "INVALID_CATEGORY";
        when(configService.resolve(categoryCode)).thenReturn(null);

        // When
        Mono<String> result = ybaClient.backupInitiate(categoryCode, batchParams);

        // Then
        StepVerifier.create(result)
                .expectErrorMatches(throwable ->
                        throwable instanceof IllegalArgumentException &&
                                throwable.getMessage().contains("No configuration found"))
                .verify();

        verify(configService).resolve(categoryCode);
        verify(backupDaoService, never()).insertBackupDetails(any(), anyString(), anyString());
    }

    @Test
    @DisplayName("Should throw error for unsupported backup type")
    void should_ThrowError_When_UnsupportedBackupType() {
        // Given
        String categoryCode = "INVALID_BACKUP_TYPE";
        YbaDynamicConfig invalidConfig = YbaDynamicConfig.builder()
                .backupCategoryType("INVALID_TYPE")
                .build();

        when(configService.resolve(categoryCode)).thenReturn(invalidConfig);
        doNothing().when(backupDaoService).insertBackupDetails(any(), anyString(), anyString());

        // When
        Mono<String> result = ybaClient.backupInitiate(categoryCode, batchParams);

        // Then
        StepVerifier.create(result)
                .expectErrorMatches(throwable ->
                        throwable instanceof IllegalArgumentException &&
                                throwable.getMessage().contains("Unsupported backup type"))
                .verify();
    }

    @Test
    @DisplayName("Should handle WebClient error during full backup")
    void should_HandleWebClientError_When_FullBackupFails() {
        // Given
        String categoryCode = "HWA_EPR_DB_BACKUP_FULL";

        when(configService.resolve(categoryCode)).thenReturn(fullBackupConfig);
        doNothing().when(backupDaoService).insertBackupDetails(any(), anyString(), anyString());

        when(webClient.post()).thenReturn(requestBodyUriSpec);
        when(requestBodyUriSpec.uri(anyString())).thenReturn(requestBodySpec);
        when(requestBodySpec.header(anyString(), anyString())).thenReturn(requestBodySpec);
        when(requestBodySpec.contentType(any())).thenReturn(requestBodySpec);
        when(requestBodySpec.bodyValue(any())).thenReturn(requestHeadersSpec);
        when(requestHeadersSpec.retrieve()).thenReturn(responseSpec);
        when(responseSpec.bodyToMono(JsonNode.class)).thenReturn(Mono.error(new RuntimeException("YBA API error")));

        // When
        Mono<String> result = ybaClient.backupInitiate(categoryCode, batchParams);

        // Then
        StepVerifier.create(result)
                .expectErrorMatches(throwable ->
                        throwable instanceof RuntimeException &&
                                throwable.getMessage().contains("YBA API error"))
                .verify();
    }
}

